{
  "name": "qlar-connector",
  "version": "1.1.0",
  "description": "QLAR WhatsApp connector: runs on your own machine and bridges Baileys to Qlar. One number per state directory, outbound connections only.",
  "main": "dist/selfhosted/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/selfhosted/main.ts",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server/main.ts",
    "start": "node dist/selfhosted/main.js",
    "start:server": "node dist/server/main.js",
    "build": "tsc",
    "bundle": "tsc --noEmit && node scripts/build.js",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "abort-controller": "^3.0.0",
    "eventsource": "^2.0.2",
    "fetch-cookie": "^2.0.3",
    "node-fetch": "^2.6.7",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tough-cookie": "^4.1.4",
    "ws": "^7.5.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
