{
  "name": "qlar-connector",
  "version": "1.0.0",
  "description": "QLAR WhatsApp connector — runs on user's machine, bridges Baileys to Messenger-BE via SignalR",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server/main.ts",
    "start:server": "node dist/server/main.js",
    "build": "tsc",
    "bundle:dev": "tsc --noEmit && node scripts/build.js https://wap-pusaka-messenger-dev.azurewebsites.net/hubs/connector",
    "bundle:prod": "tsc --noEmit && node scripts/build.js https://wap-pusaka-messenger-prod.azurewebsites.net/hubs/connector",
    "build:exe:dev": "npm run bundle:dev && pkg dist-bundle/index.cjs --targets node24-win-x64,node24-linux-x64,node24-macos-x64 --output bin/dev/qlar-connector",
    "build:exe:prod": "npm run bundle:prod && pkg dist-bundle/index.cjs --targets node24-win-x64,node24-linux-x64,node24-macos-x64 --output bin/prod/qlar-connector",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "abort-controller": "^3.0.0",
    "eventsource": "^2.0.2",
    "fetch-cookie": "^2.0.3",
    "node-fetch": "^2.6.7",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tough-cookie": "^4.1.4",
    "ws": "^7.5.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@yao-pkg/pkg": "^6.21.0",
    "esbuild": "^0.28.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
